<?xml version="1.0"?>
<sdf version="1.12" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <model name="variobot" canonical_link="base_link">
    <link name="base_link">
      <must_be_base_link>true</must_be_base_link>
    </link>

    <xacro:include
      filename="mobility_systems/mecanum_drive/48mm_n20_mecanum_drive/48mm_n20_mecanum_drive.sdf.xacro" />

    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>variobot/odom</odom_frame>
      <robot_base_frame>variobot/base_link</robot_base_frame>
      <odom_publish_frequency>60</odom_publish_frequency>
      <odom_topic>/gz/odom</odom_topic>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>

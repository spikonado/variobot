    <child>front_right_coupling_link</child>
    <axis>
      <xyz>1 0 0</xyz>
      <limit>
        <lower>-inf</lower>
        <upper>inf</upper>
        <velocity>31.41</velocity>
      </limit>
    </axis>
  </joint>

  <link name="front_right_coupling_link">
    <pose relative_to="front_right_coupling_joint" />

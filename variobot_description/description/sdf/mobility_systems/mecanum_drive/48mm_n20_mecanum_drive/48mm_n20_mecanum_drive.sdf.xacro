        <mesh>
          <uri>
            package://variobot_description/meshes/Mobility_Systems/Mecanum_Drive/48mm_N20_Mecanum_Drive/48mm_Mecanum_Wheel_Left.dae
          </uri>
        </mesh>
      </geometry>
    </visual>
    <collision name="front_left_wheel_collision">
      <pose relative_to="front_left_coupling_link" degrees="true">0.01285 0 0 0 90 0</pose>
      <geometry>
        <cylinder>
          <radius>0.024</radius>
          <length>0.025</length>
        </cylinder>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.0</mu2>
            <fdir1 gz:expressed_in="base_link">1 -1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
    <inertial auto="true" />
  </link>

  <joint name="front_right_motor_joint" type="fixed">

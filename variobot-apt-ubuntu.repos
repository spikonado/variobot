repositories:
  # Fixes https://github.com/ros/joint_state_publisher/issues/105
  ros/joint_state_publisher:
    type: git
    url: https://github.com/Amronos/joint_state_publisher.git
    version: fix-inf-revolute-joints
  # Fixes https://github.com/ros/xacro/issues/380
  ros/xacro:
    type: git
    url: https://github.com/ros/xacro.git
    version: ros2
  # Not published on ROS 2 APT repos
  micro-ROS/micro-ROS-agent:
    type: git
    url: https://github.com/micro-ROS/micro-ROS-Agent.git
    version: kilted

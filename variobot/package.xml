<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>variobot</name>
  <version>0.0.0</version>
  <description>Contains code relevant to controlling VarioBot in real life.</description>
  <maintainer email="aarav@spikonado.com">Aarav Gupta</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>micro_ros_agent</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>variobot_description</exec_depend>
  <exec_depend>variobot_control</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
